# JWT認証用のシークレットキー（必須）
# ランダムな64文字以上の文字列を設定してください
JWT_SECRET=your-secret-key-change-this-in-production-minimum-32-characters-recommended

# Basic認証の設定（本番環境用）
# アプリ全体を保護する最初の認証層
BASIC_AUTH_ENABLED=true
BASIC_AUTH_USER=your-username
BASIC_AUTH_PASSWORD=your-strong-password

# 開発環境でBasic認証をスキップする場合（本番環境では必ずfalse）
SKIP_BASIC_AUTH=false

# ========================================
# 使用方法:
# 1. このファイルを .env.local にコピー
# 2. すべての値を実際の値に変更
# 3. .env.local は絶対にGitにコミットしない
# ========================================
