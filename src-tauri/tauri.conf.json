{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Swing Trading Practice",
    "version": "0.1.0",
    "identifier": "com.example.swingtraderpractice",
    "build": {
        "devUrl": "http://localhost:3000",
        "frontendDist": "../out",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "TAURI_BUILD=true npm run build"
    },
    "app": {
        "windows": [
            {
                "title": "Swing Trading Practice",
                "width": 1280,
                "height": 800
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all"
    }
}
