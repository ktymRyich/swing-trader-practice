# Dependencies
/node_modules
/.pnp
.pnp.js

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build

# Misc
.DS_Store
Thumbs.db
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# PM2
logs/
.pm2/

# Local env files
# 重要: 本番環境の認証情報（JWT_SECRET, BASIC_AUTH_PASSWORD等）が含まれるため絶対にコミットしない
.env*.local
.env
# .env.example はテンプレートなのでコミットOK
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode
.idea
*.swp
*.swo
*~

# User data (personal information)
# 重要: ユーザーのパスワードハッシュが含まれる
data/users/*
!data/users/.gitkeep

# Session data (practice sessions)
# 重要: 個人のトレード履歴が含まれる
data/sessions/*
!data/sessions/.gitkeep

# Stock data cache
# 株価データは動的に取得するためキャッシュのみ除外
lib/data/cache/*.json
!lib/data/cache/.gitkeep

# SQLite database
# 重要: ユーザーの全セッションデータが含まれる
data/sessions.db
data/sessions.db-shm
data/sessions.db-wal

# Backup files
*.backup.*
*.json-backup.*
